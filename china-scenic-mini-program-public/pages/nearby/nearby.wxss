page{background:#f4f0e8;color:#173f48}.page{min-height:100vh;padding:74rpx 34rpx 60rpx;box-sizing:border-box}.header{display:flex;align-items:center}.back{width:58rpx;font-size:52rpx}.eyebrow{display:block;color:#b18a5c;font-size:17rpx;letter-spacing:3rpx}.title{display:block;margin-top:7rpx;font-size:40rpx;font-weight:600}.brand{margin-left:auto;color:#255c5c;font-size:23rpx;letter-spacing:4rpx}.location-card{display:flex;align-items:center;margin-top:40rpx;padding:28rpx;background:#255c5c;color:#fff}.location-card>view:first-child{flex:1}.location-title{display:block;font-size:29rpx}.location-note{display:block;margin-top:9rpx;color:rgba(255,255,255,.68);font-size:18rpx}.locate{padding:14rpx 18rpx;border:1rpx solid rgba(255,255,255,.55);font-size:19rpx}.permission{display:flex;align-items:center;margin-top:14rpx;padding:18rpx;background:#f0dfce;color:#805d3d;font-size:20rpx}.permission text{flex:1}.permission view{text-decoration:underline}.section-head{display:flex;justify-content:space-between;margin:36rpx 0 20rpx;font-size:29rpx}.section-head text:last-child{color:#9f9485;font-size:19rpx}.row{display:flex;align-items:center;margin-bottom:13rpx;padding:22rpx 18rpx;background:#fffdf8;border:1rpx solid #e2dacd}.rank{display:flex;width:52rpx;height:52rpx;align-items:center;justify-content:center;background:#e8dfd1;color:#9a7149;font-size:20rpx}.copy{flex:1;min-width:0;margin-left:17rpx}.copy text{display:block;font-size:25rpx}.copy text+text{margin-top:6rpx;color:#958b7d;font-size:18rpx}.distance{color:#7b746a;font-size:18rpx}.distance text{margin-left:9rpx;color:#b17e4b;font-size:30rpx}
