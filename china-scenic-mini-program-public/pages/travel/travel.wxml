<view class="page motion-page">
  <view class="header"><view class="back" bindtap="goBack">‹</view><view><text class="eyebrow">MY TRAVEL</text><text class="title">旅行中心</text></view><view class="nearby" bindtap="openNearby">附近景区</view></view>
  <view class="tabs"><view wx:for="{{tabs}}" wx:key="*this" class="tab {{tab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="selectTab">{{item}}</view></view>
  <block wx:if="{{tab === '概览'}}">
    <view class="summary"><view><text>{{lit.length}}</text><text>点亮景区</text></view><view><text>{{provinces}}</text><text>到访省份</text></view><view><text>{{favorites.length}}</text><text>我的收藏</text></view></view>
    <view class="progress"><view class="progress-head"><text>全国景区探索进度</text><text>{{completion}}%</text></view><view class="track"><view style="width:{{completion}}%"></view></view></view>
    <view style="display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:18rpx;"><view style="display:flex;height:116rpx;flex-direction:column;align-items:center;justify-content:center;background:#fffdf8;border:1rpx solid #e2dacd;color:#255c5c;font-size:18rpx;" data-mode="日历" bindtap="openPlanner"><text style="font-size:25rpx;color:#a06e3d;">日</text><text>旅行日历</text></view><view style="display:flex;height:116rpx;flex-direction:column;align-items:center;justify-content:center;background:#fffdf8;border:1rpx solid #e2dacd;color:#255c5c;font-size:18rpx;" data-mode="自动行程" bindtap="openPlanner"><text style="font-size:25rpx;color:#a06e3d;">路</text><text>自动行程</text></view><view style="display:flex;height:116rpx;flex-direction:column;align-items:center;justify-content:center;background:#fffdf8;border:1rpx solid #e2dacd;color:#255c5c;font-size:18rpx;" data-mode="时间轴" bindtap="openPlanner"><text style="font-size:25rpx;color:#a06e3d;">迹</text><text>足迹时间轴</text></view><view style="display:flex;height:116rpx;flex-direction:column;align-items:center;justify-content:center;background:#fffdf8;border:1rpx solid #e2dacd;color:#255c5c;font-size:18rpx;" data-mode="随机目的地" bindtap="openPlanner"><text style="font-size:25rpx;color:#a06e3d;">?</text><text>随机目的地</text></view></view>
    <view class="section-head"><view><text class="section-title">{{month}}月推荐</text><text class="section-sub">根据季节精选目的地</text></view></view>
    <scroll-view class="horizontal" scroll-x="true"><view class="horizontal-inner"><view wx:for="{{monthly}}" wx:key="id" class="recommend" data-id="{{item.id}}" bindtap="openDetail"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"/><view class="recommend-shade"></view><text>{{item.name}}</text><text>{{item.province}} · {{item.theme}}</text></view></view></scroll-view>
    <view class="section-head"><view><text class="section-title">精选路线</text><text class="section-sub">从核心景观开始游览</text></view></view>
    <view class="route-card" wx:for="{{routes}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail"><view><text>{{item.name}}经典路线</text><text>{{item.routeText}}</text></view><text>›</text></view>
  </block>
  <block wx:elif="{{tab === '收藏'}}"><view wx:if="{{favorites.length}}" class="list"><view wx:for="{{favorites}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="openDetail"><view class="grade">{{item.grade}}</view><view class="row-copy"><text>{{item.name}}</text><text>{{item.province}}{{item.city ? ' · ' + item.city : ''}}</text></view><view class="remove" data-id="{{item.id}}" catchtap="removeFavorite">取消</view></view></view><view wx:else class="empty">还没有收藏景区<text>在景区详情页点击♡即可收藏</text></view></block>
  <block wx:elif="{{tab === '清单'}}"><view wx:if="{{plans.length}}" class="list"><view wx:for="{{plans}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="openDetail"><view class="grade plan">行</view><view class="row-copy"><text>{{item.name}}</text><text>{{item.duration}} · {{item.weather}}</text></view><view class="remove" data-id="{{item.id}}" catchtap="removePlan">移除</view></view></view><view wx:else class="empty">游览清单还是空的<text>把想去的景区加入清单吧</text></view></block>
  <block wx:elif="{{tab === '成就'}}"><view class="achievement-grid"><view wx:for="{{achievements}}" wx:key="name" class="achievement {{item.unlocked ? 'unlocked' : ''}}"><view class="achievement-icon">{{item.icon}}</view><text>{{item.name}}</text><text>{{item.unlocked ? '已获得' : item.desc}}</text></view></view></block>
  <block wx:else>
    <view class="data-hero"><text class="data-kicker">DATA & PRIVACY</text><text class="data-title">数据与隐私</text><text class="data-copy">旅行记录默认保存在当前微信的小程序本地空间，不会自动上传到云端。</text></view>
    <view class="data-stats"><view><text>{{userDataItems}}</text><text>用户数据项</text></view><view><text>{{userDataSize}} KB</text><text>本地总占用</text></view></view>
    <view class="data-section"><text class="data-section-title">我的数据</text><view class="data-action primary" bindtap="exportUserData"><view><text>导出旅行数据</text><text>复制收藏、足迹、清单、笔记和评论的 JSON 备份</text></view><text>›</text></view><view class="data-action" bindtap="clearPhotoCache"><view><text>清理图片缓存</text><text>释放联网查找景区图片产生的本地缓存</text></view><text>›</text></view><view class="data-action" bindtap="resetOnboarding"><view><text>重新查看使用引导</text><text>下次进入首页时重新显示三步介绍</text></view><text>›</text></view><view class="data-action danger" bindtap="clearUserData"><view><text>清除全部旅行数据</text><text>删除收藏、清单、足迹、笔记、评论与纠错记录</text></view><text>›</text></view></view>
    <view class="data-section"><text class="data-section-title">隐私说明</text><view class="privacy-copy"><text>位置权限</text><text>仅在使用“附近景区”时读取，用于计算附近的省级代表景区；拒绝授权不会影响搜索、收藏和足迹功能。</text><text>联网内容</text><text>部分景区图片来自 Wikimedia Commons。断网时优先显示已缓存图片，文字、收藏、清单和足迹仍可使用。</text><text>内容与反馈</text><text>旅行笔记、评论、内容纠错和图片反馈目前仅保存在本机。清除微信小程序数据或更换设备后可能无法恢复，请按需导出备份。</text></view></view>
    <view class="data-version"><text>景区内容版本 2026.10</text><text>数据更新于 {{contentUpdatedAt}}</text><text>景区评级、开放与预约信息以文旅部门和景区官方公告为准。</text></view>
  </block>
</view>
