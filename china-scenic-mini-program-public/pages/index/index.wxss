.preview-mask{position:fixed;z-index:20;inset:0;display:flex;align-items:flex-end;background:rgba(7,27,31,.68)}
.preview-sheet{width:100%;max-height:76vh;box-sizing:border-box;padding:18rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));overflow-y:auto;background:#f5f1e8;color:#173f48;border-radius:18rpx 18rpx 0 0;box-shadow:0 -18rpx 60rpx rgba(0,0,0,.24)}
.preview-handle{width:62rpx;height:6rpx;margin:0 auto 24rpx;border-radius:5rpx;background:#c5b9a6}
.preview-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22rpx}
.preview-kicker{display:block;color:#98784d;font-size:19rpx;letter-spacing:2rpx}
.preview-title{display:block;margin-top:8rpx;font-size:34rpx;line-height:1.3;font-weight:600}
.preview-close{display:flex;width:54rpx;height:54rpx;align-items:center;justify-content:center;border:1rpx solid #d5ccbe;color:#6e766f;font-size:36rpx;line-height:1}
.preview-gallery{display:flex;gap:14rpx}
.preview-photo{width:calc(50% - 7rpx);min-width:0;overflow:hidden;background:#e4ded2}
.preview-photo image{display:block;width:100%;height:226rpx;background:#d9d2c4}
.preview-caption{display:block;padding:12rpx 12rpx 0;color:#304b4a;font-size:21rpx;line-height:1.35}
.preview-credit{display:block;padding:7rpx 12rpx 12rpx;color:#8b8377;font-size:17rpx;line-height:1.35}
.preview-action{height:94rpx;margin-top:20rpx;overflow:hidden}
.preview-light{display:flex;height:82rpx;align-items:center;justify-content:center;box-sizing:border-box;border:1rpx solid #b88a55;background:#d6a35f;color:#173f48;font-size:25rpx;font-weight:600;letter-spacing:2rpx;transform:translateY(105%);opacity:0;pointer-events:none;transition:transform .65s cubic-bezier(.2,.75,.25,1),opacity .35s ease}
.preview-action.is-ready .preview-light{transform:translateY(0);opacity:1;pointer-events:auto}
.preview-light.is-lit{border-color:#315f5d;background:#315f5d;color:#f8f5ed}

@keyframes previewMaskIn{from{opacity:0}to{opacity:1}}
@keyframes previewSheetIn{0%{opacity:0;transform:translateY(100%) scale(.985)}70%{opacity:1;transform:translateY(-10rpx) scale(1.002)}100%{opacity:1;transform:translateY(0) scale(1)}}
@keyframes previewHandleIn{from{transform:scaleX(.2);opacity:0}to{transform:scaleX(1);opacity:1}}
@keyframes previewHeadIn{from{opacity:0;transform:translateY(18rpx)}to{opacity:1;transform:translateY(0)}}
@keyframes previewPhotoIn{from{opacity:0;transform:translateY(28rpx) scale(.94)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes previewGlow{0%,100%{box-shadow:0 12rpx 24rpx rgba(166,112,54,.12)}50%{box-shadow:0 15rpx 34rpx rgba(166,112,54,.34)}}
.preview-mask{animation:previewMaskIn .28s ease-out both}
.preview-sheet{transform-origin:50% 100%;animation:previewSheetIn .62s cubic-bezier(.18,.82,.24,1) both}
.preview-handle{animation:previewHandleIn .42s .18s cubic-bezier(.2,.8,.2,1) both}
.preview-head{animation:previewHeadIn .48s .2s ease-out both}
.preview-photo{opacity:0;animation:previewPhotoIn .62s .35s cubic-bezier(.2,.75,.25,1) both}
.preview-photo:nth-child(2){animation-delay:.48s}
.preview-light{transition:transform .82s cubic-bezier(.16,1,.3,1),opacity .46s ease,box-shadow .46s ease}
.preview-action.is-ready .preview-light{animation:previewGlow 2.6s .82s ease-in-out infinite}
.preview-media{position:relative;height:226rpx;overflow:hidden;background:#d9d2c4}
.preview-media image{position:relative;z-index:2;height:100%;opacity:0;transition:opacity .35s ease}
.preview-media image.is-loaded{opacity:1}
.preview-photo.is-single{width:100%}
.preview-photo.is-single .preview-media{height:320rpx}
.preview-source{display:block;padding:0 12rpx 14rpx;color:#8c6539;font-size:18rpx;text-decoration:underline}
.preview-loading{position:absolute;z-index:1;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8c8578;font-size:18rpx;letter-spacing:1rpx}
.preview-loading view{width:48rpx;height:48rpx;margin-bottom:14rpx;border:4rpx solid rgba(49,95,93,.18);border-top-color:#315f5d;border-radius:50%;animation:previewSpin .8s linear infinite}
.preview-error{position:absolute;z-index:3;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#746e64;font-size:19rpx}
.preview-error view{margin-top:15rpx;padding:10rpx 20rpx;border:1rpx solid #af916a;color:#765a36}
.preview-missing{height:260rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(145deg,#ded8cb,#eee9df);color:#756e63}
.preview-missing-mark{font-size:58rpx;color:#a68151;line-height:1}
.preview-missing text:nth-child(2){margin-top:16rpx;color:#415b58;font-size:24rpx;font-weight:600;letter-spacing:2rpx}
.preview-missing text:last-child{margin-top:10rpx;font-size:18rpx;letter-spacing:1rpx}
.preview-celebrate{display:flex;align-items:center;justify-content:center;gap:16rpx;margin-top:15rpx;color:#ae7737;font-size:21rpx;letter-spacing:3rpx;animation:celebrateIn .55s cubic-bezier(.16,1,.3,1) both}
@keyframes previewSpin{to{transform:rotate(360deg)}}
@keyframes celebrateIn{from{opacity:0;transform:scale(.7) translateY(15rpx)}to{opacity:1;transform:scale(1) translateY(0)}}
.opening-screen{position:fixed;z-index:100;top:0;right:0;bottom:0;left:0;overflow:hidden;background:linear-gradient(160deg,#102f38,#245959 62%,#58796a);color:#f8f5ed;transition:opacity .5s ease,transform .5s cubic-bezier(.2,.8,.2,1)}
.opening-screen.is-leaving{opacity:0;transform:scale(1.035)}
.opening-landscape{position:absolute;inset:0;overflow:hidden;animation:openingScene 1.2s ease-out both}
.opening-sun{position:absolute;top:19%;right:17%;width:150rpx;height:150rpx;border-radius:50%;background:#edbf7b;box-shadow:0 0 110rpx 35rpx rgba(239,186,109,.18);animation:openingSun 1.2s cubic-bezier(.16,1,.3,1) both}
.opening-ridge{position:absolute;width:1050rpx;height:1050rpx;border-radius:100rpx;transform:rotate(45deg);background:linear-gradient(120deg,#3f7770,#244f53);animation:openingRidge 1.2s cubic-bezier(.16,1,.3,1) both}
.opening-ridge-back{left:-580rpx;top:52%;opacity:.7}
.opening-ridge-front{right:-650rpx;top:62%;background:linear-gradient(120deg,#1c474b,#102f38)}
.opening-mist{position:absolute;left:-20%;top:64%;width:140%;height:200rpx;background:radial-gradient(ellipse,rgba(239,232,208,.22),transparent 68%);animation:openingMist 1.2s ease-out both}
.opening-brand{position:absolute;top:33%;left:0;right:0;display:flex;flex-direction:column;align-items:center;animation:openingBrand 1.2s cubic-bezier(.16,1,.3,1) both}
.opening-en{font-size:19rpx;letter-spacing:8rpx;color:#e8bb7b}
.opening-name{margin-top:24rpx;padding-left:20rpx;font-size:100rpx;font-weight:500;line-height:1.35;letter-spacing:20rpx}
.opening-rule{width:52rpx;height:2rpx;margin:30rpx 0;background:#e8bb7b}
.opening-copy{font-size:24rpx;letter-spacing:6rpx;color:rgba(248,245,237,.78)}
.opening-bottom{position:absolute;left:76rpx;right:76rpx;bottom:calc(80rpx + env(safe-area-inset-bottom));text-align:center}
.opening-note{display:block;margin-bottom:26rpx;font-size:20rpx;letter-spacing:4rpx;color:rgba(248,245,237,.55);animation:openingBrand 1.2s ease-out both}
.opening-action{height:100rpx;overflow:hidden}
.opening-start,.opening-start[disabled]{display:flex;align-items:center;justify-content:center;width:100%;height:88rpx;margin:0;padding:0;border:1rpx solid #e9b978;border-radius:6rpx;background:#edbd7c;color:#173f48;font-size:28rpx;letter-spacing:6rpx;opacity:0;transform:translateY(115%);pointer-events:none;transition:transform .5s cubic-bezier(.16,1,.3,1),opacity .5s ease}
.opening-start:after{border:0}
.opening-action.is-ready .opening-start{opacity:1;transform:translateY(0);pointer-events:auto}
.opening-arrow{margin-left:28rpx;font-size:34rpx;letter-spacing:0}
.opening-start-pressed{filter:brightness(.93)}
