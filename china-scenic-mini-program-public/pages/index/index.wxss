@keyframes countBump{0%{transform:scale(1)}38%{transform:scale(1.32);color:#fff2bc;text-shadow:0 0 30rpx #f3c070}100%{transform:scale(1)}}
@keyframes pinFlash{0%{transform:scale(1)}40%{transform:scale(1.8);box-shadow:0 0 42rpx 20rpx rgba(243,192,112,.72)}100%{transform:scale(1)}}
@keyframes pinBurst{0%{transform:scale(.4);opacity:1}100%{transform:scale(2.6);opacity:0}}
@keyframes listLit{0%{background:rgba(243,192,112,.25)}100%{background:transparent}}
@keyframes footprintOpen{from{opacity:0;transform:translateY(-16rpx)}to{opacity:1;transform:translateY(0)}}
.nearby-link{margin-top:20rpx;color:rgba(255,255,255,.76);font-size:21rpx;letter-spacing:1rpx}

.spot-section{padding:84rpx 40rpx 54rpx;color:#253f40;background:#eee9df}.section-kicker{font-size:18rpx;letter-spacing:4rpx;color:#aa7a47;margin-bottom:18rpx}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:40rpx}.section-title{display:block;font-size:52rpx;letter-spacing:5rpx;font-weight:600}.section-sub{display:block;margin-top:14rpx;font-size:22rpx;color:#768080;letter-spacing:1rpx}.section-count{font-family:Georgia,serif;color:#b07d48;font-size:24rpx;margin-bottom:7rpx}.spot-grid{display:flex;flex-direction:column;gap:28rpx}.spot-card{overflow:hidden;border-radius:10rpx;background:#f9f6ef;box-shadow:0 16rpx 42rpx rgba(45,57,53,.1)}.spot-art{position:relative;height:260rpx;overflow:hidden;background:linear-gradient(135deg,#b57a42,#e0bc78)}.spot-art.red{background:linear-gradient(135deg,#762f29,#bd6a4e)}.spot-art.teal{background:linear-gradient(135deg,#285d5c,#79a493)}.spot-art.blue{background:linear-gradient(135deg,#315e71,#8bb0b2)}.spot-index{position:absolute;left:28rpx;top:22rpx;color:rgba(255,255,255,.88);font:40rpx Georgia,serif;letter-spacing:2rpx;z-index:3}.spot-tag{position:absolute;right:24rpx;top:25rpx;padding:8rpx 17rpx;border:1rpx solid rgba(255,255,255,.55);color:#fff;font-size:18rpx;letter-spacing:2rpx;z-index:3}.art-sun{position:absolute;right:100rpx;top:78rpx;width:70rpx;height:70rpx;border-radius:50%;background:rgba(255,226,164,.85)}.art-mountain{position:absolute;bottom:-95rpx;width:0;height:0;border-left:210rpx solid transparent;border-right:210rpx solid transparent;border-bottom:290rpx solid rgba(27,65,65,.72)}.art-one{left:-90rpx}.art-two{right:-130rpx;transform:scale(1.2);border-bottom-color:rgba(28,56,60,.84)}.spot-copy{padding:30rpx 30rpx 32rpx}.spot-title-row{display:flex;justify-content:space-between;align-items:center}.spot-name{font-size:36rpx;font-weight:600;letter-spacing:2rpx}.spot-arrow{color:#b47c43;font-size:34rpx}.spot-city{display:block;margin-top:8rpx;color:#a67a4c;font-size:20rpx;letter-spacing:1rpx}.spot-desc{display:block;margin-top:20rpx;color:#657171;font-size:23rpx;line-height:1.75}.spot-link{display:inline-block;margin-top:24rpx;padding-top:16rpx;border-top:1rpx solid #ded8cb;color:#385c5b;font-size:20rpx;letter-spacing:1rpx}.page-footer{display:flex;align-items:center;justify-content:center;margin-top:64rpx;color:#958d80;font-size:19rpx;letter-spacing:2rpx}.footer-line{width:50rpx;height:1rpx;margin:0 18rpx;background:#c9c0b2}.onboarding-mask{position:fixed;z-index:120;inset:0;display:flex;align-items:center;justify-content:center;padding:44rpx;background:rgba(7,27,30,.78)}.onboarding-card{box-sizing:border-box;width:100%;max-width:660rpx;padding:34rpx;background:#fffdf8;color:#173f48;box-shadow:0 24rpx 70rpx rgba(0,0,0,.26);animation:onboardingIn .45s cubic-bezier(.16,1,.3,1) both}.onboarding-top{display:flex;justify-content:space-between;color:#a67b49;font-size:19rpx;letter-spacing:2rpx}.onboarding-top text:last-child{padding:4rpx 0;color:#7d786f;letter-spacing:0}.onboarding-index{margin-top:48rpx;color:#c18d58;font:64rpx Georgia,serif}.onboarding-title{display:block;margin-top:14rpx;font-size:42rpx;font-weight:600}.onboarding-text{display:block;min-height:110rpx;margin-top:20rpx;color:#66706b;font-size:24rpx;line-height:1.8}.onboarding-dots{display:flex;gap:10rpx;margin-top:30rpx}.onboarding-dots view{width:12rpx;height:12rpx;border-radius:50%;background:#d8d0c4;transition:width .25s ease}.onboarding-dots view.active{width:34rpx;border-radius:10rpx;background:#c18d58}.onboarding-next{margin-top:30rpx;padding:22rpx;background:#255c5c;color:#fff;text-align:center;font-size:24rpx;letter-spacing:2rpx}@keyframes onboardingIn{from{opacity:0;transform:translateY(35rpx) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
