page { height: 100%; background: #f4f0e8; color: #173f48; }
.page { min-height: 100vh; box-sizing: border-box; padding: 74rpx 42rpx 40rpx; background: #f4f0e8; }
.header { display:flex; align-items:center; }.back-btn { width:60rpx; height:60rpx; line-height:52rpx; font-size:52rpx; color:#255c5c; }.eyebrow { display:block; font-size:17rpx; letter-spacing:3rpx; color:#b18a5c; }.title { display:block; margin-top:8rpx; font-size:40rpx; letter-spacing:4rpx; font-weight:600; }.header-mark { margin-left:auto; font-size:24rpx; letter-spacing:5rpx; color:#255c5c; writing-mode:vertical-rl; }
.intro { margin-top:58rpx; font-size:42rpx; letter-spacing:3rpx; line-height:1.45; }.accent { color:#b87c46; }.intro-line { width:84rpx; height:3rpx; margin-top:20rpx; background:#d7a96b; }
.search { height:92rpx; display:flex; align-items:center; margin-top:38rpx; padding:0 26rpx; box-sizing:border-box; background:#fffdf8; border:1rpx solid #e5ded1; border-radius:6rpx; box-shadow:0 12rpx 28rpx rgba(39,66,65,.06); }.search-icon { font-size:42rpx; color:#b18a5c; margin-right:16rpx; transform:rotate(-20deg); }.search input { flex:1; font-size:25rpx; color:#173f48; }.clear { color:#a69b8a; font-size:36rpx; padding:8rpx; }
.tools{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:16rpx}.tools view{display:flex;height:68rpx;align-items:center;justify-content:center;gap:10rpx;border:1rpx solid #d9cfbf;background:#f9f5ed;color:#255c5c;font-size:20rpx}.tools view>text:first-child{color:#b17d48;font-size:27rpx}
.filter-row,.theme-row { margin:32rpx -42rpx 0; white-space:nowrap; }.filter-list,.theme-list { display:flex; padding:0 42rpx; }.filter { flex:none; margin-right:34rpx; padding-bottom:14rpx; font-size:24rpx; color:#938d80; }.filter.active { color:#255c5c; font-weight:600; border-bottom:3rpx solid #c18d58; }.section-head { display:flex; align-items:end; justify-content:space-between; margin-top:48rpx; }.section-title { display:block; font-size:34rpx; letter-spacing:2rpx; font-weight:600; }.section-sub { display:block; margin-top:8rpx; font-size:21rpx; color:#a49a8a; }.count { font-size:20rpx; color:#ad9a80; }.theme-row { margin-top:26rpx; }.theme-list { padding-left:0; }.theme { flex:none; margin-right:14rpx; padding:12rpx 24rpx; border:1rpx solid #ddd4c5; border-radius:30rpx; color:#867e72; font-size:22rpx; background:#f8f4ec; }.theme.active { background:#255c5c; border-color:#255c5c; color:#fff8ec; }
.spot-list { height:760rpx; margin:30rpx -42rpx 0; padding:0 42rpx; box-sizing:border-box; }.spot { display:flex; margin-bottom:24rpx; padding:18rpx; background:#fffdf8; border:1rpx solid #e8e0d3; border-radius:6rpx; box-shadow:0 10rpx 24rpx rgba(39,66,65,.05); }.spot-art { position:relative; flex:none; width:214rpx; height:218rpx; overflow:hidden; border-radius:4rpx; background:#d8b27a; }.spot-art.gold { background:#c49a62; }.spot-art.red { background:#a96e54; }.spot-art.teal { background:#4f8580; }.spot-art.blue { background:#74989a; }.spot-index { position:absolute; left:18rpx; top:14rpx; color:rgba(255,250,236,.78); font:28rpx Georgia,serif; }.spot-stamp { position:absolute; right:12rpx; top:14rpx; padding:5rpx 8rpx; color:#fff9eb; border:1rpx solid rgba(255,255,255,.6); font-size:15rpx; letter-spacing:1rpx; z-index:2; }.art-sun { position:absolute; width:90rpx; height:90rpx; right:22rpx; top:38rpx; border-radius:50%; background:rgba(247,213,151,.7); }.art-mountain { position:absolute; bottom:-30rpx; width:0; height:0; border-left:120rpx solid transparent; border-right:120rpx solid transparent; border-bottom:190rpx solid rgba(28,76,76,.7); }.art-mountain.one { left:-45rpx; }.art-mountain.two { left:62rpx; transform:scale(.8); border-bottom-color:rgba(247,232,193,.48); }.spot-copy { padding:12rpx 14rpx 6rpx 22rpx; flex:1; min-width:0; }.spot-name { font-size:32rpx; font-weight:600; letter-spacing:2rpx; }.spot-city { margin-top:7rpx; color:#ad8d68; font-size:19rpx; }.spot-desc { margin-top:24rpx; color:#8b8377; line-height:1.65; font-size:21rpx; }.spot-link { margin-top:19rpx; color:#255c5c; font-size:20rpx; }.spot-link text { color:#b87c46; margin-left:8rpx; font-size:28rpx; }.empty { display:flex; flex-direction:column; align-items:center; padding-top:100rpx; color:#827b70; font-size:27rpx; }.empty-icon { font-size:72rpx; color:#c39a6b; transform:rotate(-20deg); }.empty-sub { margin-top:14rpx; color:#aaa093; font-size:21rpx; }
