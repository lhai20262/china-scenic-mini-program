<view class="page motion-page" wx:if="{{spot}}">
  <view class="reading-progress" style="width:{{scrollProgress}}%"></view>
  <view class="hero">
    <view class="hero-fallback {{coverLoading ? 'loading' : ''}}"></view>
    <swiper wx:if="{{heroPhotos.length}}" class="hero-swiper" current="{{currentHeroIndex}}" circular="{{heroPhotos.length > 1}}" bindchange="onHeroChange">
      <swiper-item wx:for="{{heroPhotos}}" wx:key="src"><view class="hero-slide"><image wx:if="{{!item.error}}" class="hero-image {{item.loaded ? 'ready' : ''}}" src="{{item.src}}" mode="aspectFill" data-index="{{index}}" bindtap="previewCover" bindload="heroImageLoaded" binderror="heroImageError"/></view></swiper-item>
    </swiper>
    <view class="shade"></view>
    <view class="top"><view class="icon-btn" bindtap="goBack">‹</view><view class="icon-btn favorite {{favorite ? 'active' : ''}}" bindtap="toggleFavorite">{{favorite ? '♥' : '♡'}}</view></view>
    <view wx:if="{{heroPhotos.length}}" class="photo-tools"><view bindtap="showCurrentPhotoSource">来源</view><view bindtap="reportCurrentPhoto">图片有误</view></view>
    <view wx:if="{{heroPhotos.length > 1}}" class="hero-dots"><view wx:for="{{heroPhotos}}" wx:key="src" class="{{currentHeroIndex === index ? 'active' : ''}}"></view></view>
    <view class="hero-copy"><text class="badge">{{spot.grade}}</text><text class="province">{{spot.province}}{{spot.city ? ' · ' + spot.city : ''}}</text><view class="name-row"><text class="name">{{spot.name}}</text><text class="copy-name" bindtap="copySpotName">复制名称</text></view><text class="theme">{{spot.theme}} · 建议游玩 {{spot.duration}}</text></view>
  </view>
  <comment-ticker spot-id="{{spot.id}}" spot-name="{{spot.name}}"/>
  <view class="quick-actions three"><view class="quick {{planned ? 'active' : ''}}" bindtap="togglePlan"><text>{{planned ? '✓' : '+'}}</text><text>{{planned ? '已在清单' : '加入清单'}}</text></view><view class="quick {{lit ? 'active' : ''}}" bindtap="toggleLit"><text>{{lit ? '✓' : '○'}}</text><text>{{lit ? '已点亮' : '点亮足迹'}}</text></view><view class="quick" bindtap="randomSpot"><text>↻</text><text>换个景区</text></view></view>
  <view class="section"><text class="kicker">DESTINATION</text><text class="section-title">景区介绍</text><view class="spot-tags"><text wx:for="{{spot.tags}}" wx:key="*this">{{item}}</text></view><text class="body">{{spot.description}}</text><view class="content-meta"><text>内容整理自景区名录与公开资料，仅供游览参考</text><text>更新于 {{spot.contentUpdatedAt}}</text><text class="feedback-link" bindtap="openFeedback">内容有误？提交纠错</text></view><view class="meta"><view><text>推荐季节</text><text>{{spot.recommended ? '当月适合游览' : '建议错峰选择季节'}}</text></view><view><text>建议时长</text><text>{{spot.duration}}</text></view></view></view>
  <view class="section guide-section"><view class="guide-heading"><view><text class="kicker">SCENIC GUIDE</text><text class="section-title">景区文字讲解</text></view><view class="guide-size"><text wx:for="{{guideSizes}}" wx:key="key" class="{{guideSize === item.key ? 'active' : ''}}" data-size="{{item.key}}" bindtap="selectGuideSize">{{item.label}}</text></view></view><view class="guide-content guide-{{guideSize}} {{guideExpanded || !spot.guideExpandable ? 'expanded' : ''}}"><view wx:for="{{spot.guideSections}}" wx:key="title" class="guide-block"><text class="guide-title">{{index + 1}} · {{item.title}}</text><text class="guide-text">{{item.text}}</text></view></view><view wx:if="{{spot.guideExpandable}}" class="guide-toggle" bindtap="toggleGuide"><text>{{guideExpanded ? '收起讲解' : '展开完整讲解'}}</text><text class="guide-arrow {{guideExpanded ? 'up' : ''}}">⌄</text></view><text class="guide-note">文字内容用于游览参考，具体信息请以景区现场及官方公告为准。</text></view>
  <view class="section"><text class="kicker">ROUTE</text><text class="section-title">游览路线</text><view class="segments"><view wx:for="{{routeModes}}" wx:key="*this" class="segment {{routeMode === item ? 'active' : ''}}" data-mode="{{item}}" bindtap="selectRoute">{{item}}</view></view><view class="route"><view wx:for="{{spot.route}}" wx:key="*this" class="route-row"><view class="route-index">{{index + 1}}</view><view class="route-line"></view><text>{{item}}</text></view></view><text class="route-note">{{routeMode === '轻松' ? '减少折返，途中预留休息时间。' : routeMode === '亲子' ? '降低步行强度，优先安排互动和休息区域。' : '按核心景观顺序游览，适合首次到访。'}}</text></view>
  <view class="section notice"><text class="kicker">TRAVEL NOTICE</text><text class="section-title">天气与出行提醒</text><text class="body">{{spot.weather}}</text><text class="notice-foot">开放时间、预约、票务和实时天气请以景区官方公告为准。</text></view>
  <view class="section" style="background:#fffdf8;"><text class="kicker">MY NOTE</text><text class="section-title">旅行笔记</text><view style="display:flex;align-items:center;margin-top:22rpx;"><text wx:for="{{ratings}}" wx:key="*this" style="margin-right:8rpx;color:{{noteRating >= item ? '#d49a4d' : '#d8d0c4'}};font-size:37rpx;" data-rating="{{item}}" bindtap="selectRating">★</text><text style="margin-left:12rpx;color:#8e8477;font-size:20rpx;">{{noteRating ? noteRating + ' 星' : '点击评分'}}</text></view><textarea style="box-sizing:border-box;width:100%;height:220rpx;margin-top:22rpx;padding:20rpx;border:1rpx solid #ddd3c4;background:#f5f0e7;color:#354c4b;font-size:23rpx;line-height:1.7;" maxlength="500" value="{{noteText}}" placeholder="记录这里的风景、同行的人和当时的心情…" bindinput="inputNote"/><view style="display:flex;justify-content:flex-end;margin-top:18rpx;"><view wx:if="{{noteText || noteRating}}" style="margin-right:14rpx;padding:15rpx 22rpx;border:1rpx solid #cdbfae;color:#8d6c49;font-size:20rpx;" bindtap="deleteNote">清空</view><view style="padding:15rpx 22rpx;border:1rpx solid #255c5c;background:#255c5c;color:#fff;font-size:20rpx;" bindtap="saveNote">{{noteSaved ? '已保存' : '保存笔记'}}</view></view></view>
  <view wx:if="{{feedbackOpen}}" class="feedback-mask" bindtap="closeFeedback"><view class="feedback-sheet" catchtap="stopFeedbackTap"><view class="feedback-head"><text>内容纠错</text><text bindtap="closeFeedback">×</text></view><text class="feedback-tip">请说明景区名称、评级或介绍中需要修改的地方。</text><textarea maxlength="300" value="{{feedbackText}}" placeholder="填写需要纠正的内容" bindinput="inputFeedback"/><view class="feedback-submit" bindtap="submitFeedback">提交反馈</view></view></view>
  <view wx:if="{{showBackTop}}" class="back-top" bindtap="backToTop">↑</view>
</view>
