page{background:#f4f0e8;color:#173f48}.page{min-height:100vh;padding-bottom:70rpx}.hero{position:relative;height:620rpx;overflow:hidden;background:#315f5d}.hero-swiper,.hero-slide,.hero-image,.hero-fallback,.shade{position:absolute;inset:0;width:100%;height:100%}.hero-swiper{z-index:1}.hero-slide{overflow:hidden}.hero-fallback{z-index:0;background:#315f5d}.hero-fallback.loading{background:linear-gradient(100deg,#284f4e 20%,#3d6d69 50%,#284f4e 80%);background-size:220% 100%;animation:heroLoading 1.35s ease-in-out infinite}.hero-image{opacity:0;transform:scale(1.025);transition:opacity .5s ease,transform 1.2s cubic-bezier(.16,1,.3,1)}.hero-image.ready{opacity:1;transform:scale(1)}.shade{z-index:2;pointer-events:none;background:linear-gradient(180deg,rgba(8,29,31,.18),rgba(8,29,31,.78))}.top{position:relative;z-index:3;display:flex;justify-content:space-between;padding:76rpx 34rpx}.icon-btn{display:flex;width:64rpx;height:64rpx;align-items:center;justify-content:center;border:1rpx solid rgba(255,255,255,.58);background:rgba(10,39,41,.28);color:#fff;font-size:46rpx}.favorite{font-size:34rpx}.favorite.active{color:#efc17f}.photo-tools{position:absolute;z-index:3;right:32rpx;bottom:178rpx;display:flex;gap:10rpx}.photo-tools view{padding:9rpx 13rpx;border:1rpx solid rgba(255,255,255,.46);background:rgba(8,30,31,.34);color:rgba(255,255,255,.9);font-size:17rpx}.hero-dots{position:absolute;z-index:3;left:38rpx;bottom:180rpx;display:flex;gap:8rpx}.hero-dots view{width:10rpx;height:10rpx;border-radius:50%;background:rgba(255,255,255,.4);transition:width .25s ease,background .25s ease}.hero-dots view.active{width:28rpx;border-radius:8rpx;background:#fff}.hero-copy{position:absolute;z-index:3;right:38rpx;bottom:46rpx;left:38rpx;color:#fff}.badge{display:inline-block;padding:6rpx 15rpx;border:1rpx solid rgba(255,255,255,.7);font-size:20rpx}.province,.name,.theme{display:block}.province{margin-top:24rpx;font-size:22rpx;letter-spacing:2rpx;color:rgba(255,255,255,.78)}.name{margin-top:10rpx;font-size:48rpx;font-weight:600}.theme{margin-top:18rpx;font-size:22rpx;color:rgba(255,255,255,.82)}.quick-actions{display:grid;grid-template-columns:repeat(2,1fr);margin:0 30rpx;transform:translateY(-24rpx);background:#fffdf8;border:1rpx solid #e3d8c8}.quick{display:flex;height:112rpx;align-items:center;justify-content:center;gap:10rpx;border-right:1rpx solid #e3d8c8;color:#6f685e;font-size:21rpx}.quick:last-child{border:0}.quick>text:first-child{color:#b07b45;font-size:27rpx}.quick.active{color:#255c5c;background:#edf4f1}.section{margin:18rpx 30rpx 0;padding:34rpx;background:#fffdf8;border:1rpx solid #e3d8c8}.kicker{display:block;color:#b18a5c;font-size:18rpx;letter-spacing:3rpx}.section-title{display:block;margin-top:10rpx;font-size:32rpx;font-weight:600}.body{display:block;margin-top:22rpx;color:#626b67;font-size:25rpx;line-height:1.9}.meta{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:26rpx}.meta view{padding:18rpx;background:#f0ebe2}.meta text{display:block;font-size:20rpx;color:#978a78}.meta text+text{margin-top:8rpx;color:#245b5a;font-size:22rpx}.segments{display:flex;margin-top:24rpx;border:1rpx solid #d7cdbf}.segment{flex:1;padding:15rpx 0;text-align:center;color:#887d70;font-size:21rpx}.segment.active{background:#255c5c;color:#fff}.route{margin-top:26rpx}.route-row{position:relative;display:flex;align-items:center;min-height:78rpx}.route-index{z-index:2;display:flex;width:46rpx;height:46rpx;align-items:center;justify-content:center;border-radius:50%;background:#c18d58;color:#fff;font-size:20rpx}.route-line{position:absolute;top:50rpx;bottom:-28rpx;left:22rpx;width:2rpx;background:#d9c9b5}.route-row:last-child .route-line{display:none}.route-row>text{margin-left:20rpx;font-size:24rpx}.route-note,.notice-foot{display:block;margin-top:18rpx;color:#918778;font-size:20rpx;line-height:1.7}.notice{background:#e8efeb}@keyframes heroLoading{0%{background-position:120% 0}100%{background-position:-120% 0}}

.content-meta{margin-top:26rpx;padding-top:18rpx;border-top:1rpx solid #e7ded1;color:#9a9082;font-size:18rpx;line-height:1.7}.content-meta text{display:block}.feedback-link{margin-top:8rpx;color:#80592e;text-decoration:underline}.feedback-mask{position:fixed;z-index:40;inset:0;display:flex;align-items:flex-end;background:rgba(8,28,31,.66);animation:feedbackFade .2s ease both}.feedback-sheet{box-sizing:border-box;width:100%;padding:30rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));background:#fffdf8;border-radius:24rpx 24rpx 0 0;animation:feedbackUp .35s cubic-bezier(.16,1,.3,1) both}.feedback-head{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:600}.feedback-head text:last-child{padding:8rpx 14rpx;color:#777;font-size:38rpx;font-weight:400}.feedback-tip{display:block;margin-top:16rpx;color:#81796e;font-size:21rpx;line-height:1.6}.feedback-sheet textarea{box-sizing:border-box;width:100%;height:190rpx;margin-top:22rpx;padding:18rpx;border:1rpx solid #d9cfbf;background:#f5f0e7;color:#354c4b;font-size:23rpx;line-height:1.6}.feedback-submit{margin-top:20rpx;padding:20rpx;background:#255c5c;color:#fff;text-align:center;font-size:23rpx}@keyframes feedbackFade{from{opacity:0}to{opacity:1}}@keyframes feedbackUp{from{transform:translateY(100%)}to{transform:translateY(0)}}

.guide-section{background:linear-gradient(180deg,#fffdf8,#f8f2e8)}.guide-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.guide-size{display:flex;margin-top:2rpx;border:1rpx solid #d8ccbc}.guide-size text{display:flex;width:52rpx;height:48rpx;align-items:center;justify-content:center;border-right:1rpx solid #d8ccbc;color:#8b7e6d;font-size:19rpx}.guide-size text:last-child{border-right:0}.guide-size text.active{background:#255c5c;color:#fff}.guide-content{position:relative;max-height:660rpx;margin-top:26rpx;overflow:hidden;transition:max-height .6s cubic-bezier(.16,1,.3,1)}.guide-content:not(.expanded)::after{content:'';position:absolute;right:0;bottom:0;left:0;height:150rpx;background:linear-gradient(180deg,rgba(248,242,232,0),#f8f2e8 82%);pointer-events:none}.guide-content.expanded{max-height:4000rpx}.guide-block{padding:24rpx 0;border-top:1rpx solid #e4d9ca}.guide-block:first-child{padding-top:0;border-top:0}.guide-title,.guide-text{display:block}.guide-title{color:#255c5c;font-size:24rpx;font-weight:600;letter-spacing:1rpx}.guide-text{margin-top:14rpx;color:#5d6864;line-height:2;text-align:justify}.guide-small .guide-text{font-size:22rpx}.guide-medium .guide-text{font-size:25rpx}.guide-large .guide-text{font-size:29rpx;line-height:2.05}.guide-toggle{display:flex;position:relative;z-index:2;align-items:center;justify-content:center;gap:8rpx;margin-top:18rpx;padding:18rpx;border:1rpx solid #d6c8b5;background:#fffdf8;color:#80592e;font-size:21rpx}.guide-arrow{display:inline-block;font-size:26rpx;transition:transform .3s ease}.guide-arrow.up{transform:rotate(180deg)}.guide-note{display:block;margin-top:16rpx;color:#9a9082;font-size:18rpx;line-height:1.6}
.reading-progress{position:fixed;z-index:60;top:0;left:0;height:5rpx;background:#d49a4d;transition:width .15s linear}.name-row{display:flex;align-items:flex-end;gap:18rpx}.copy-name{flex:none;margin-bottom:7rpx;padding:7rpx 11rpx;border:1rpx solid rgba(255,255,255,.55);color:rgba(255,255,255,.86);font-size:17rpx}.quick-actions.three{grid-template-columns:repeat(3,1fr)}.back-top{position:fixed;z-index:25;right:28rpx;bottom:42rpx;display:flex;width:72rpx;height:72rpx;align-items:center;justify-content:center;border-radius:50%;background:#255c5c;color:#fff;font-size:33rpx;box-shadow:0 8rpx 24rpx rgba(20,60,59,.25)}
.spot-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:20rpx}.spot-tags text{padding:8rpx 14rpx;background:#edf3ef;color:#326260;font-size:18rpx}
