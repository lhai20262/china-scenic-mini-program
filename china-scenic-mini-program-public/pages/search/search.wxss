page { background:#f4f0e8; color:#173f48; }.summary{display:-webkit-box;min-height:59rpx;margin-top:12rpx;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:#777268;font-size:19rpx;line-height:1.55}.card{transition:transform .18s ease,box-shadow .18s ease}.card:active{transform:scale(.985);box-shadow:0 8rpx 20rpx rgba(31,62,60,.1)}.name{display:-webkit-box;min-height:81rpx;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2}.detail-link{padding-top:14rpx;border-top:1rpx solid #eee6da}@media (max-width:360px){.page{padding-right:24rpx;padding-left:24rpx}.grid{gap:14rpx}.copy{padding:18rpx 14rpx}.name{font-size:25rpx}.summary{font-size:18rpx}.province{padding-right:18rpx;padding-left:18rpx}}
.landmark-note { margin-top:20rpx; padding-top:14rpx; border-top:1rpx solid #e8e0d3; color:#8b8172; font-size:19rpx; letter-spacing:1rpx; }
.grades { display:flex; flex-wrap:wrap; row-gap:14rpx; margin-top:22rpx; }
.page { padding:74rpx 36rpx 40rpx; }
.travel-entry{margin-left:auto;padding:13rpx 16rpx;border:1rpx solid #b9afa0;color:#255c5c;font-size:19rpx}
.detail-link{margin-top:16rpx;color:#255c5c;font-size:20rpx}.detail-link text{float:right;color:#b17d48;font-size:28rpx}
.header { display:flex; align-items:center; }.back { width:60rpx; height:60rpx; line-height:52rpx; font-size:52rpx; }.eyebrow { display:block; font-size:17rpx; letter-spacing:2rpx; color:#b18a5c; }.title { display:block; margin-top:8rpx; font-size:40rpx; font-weight:600; letter-spacing:3rpx; }.brand { margin-left:auto; font-size:24rpx; color:#255c5c; letter-spacing:4rpx; }.subtitle { margin-top:38rpx; color:#938d80; font-size:24rpx; }
.search { display:flex; align-items:center; height:92rpx; padding:0 24rpx; margin-top:28rpx; border:1rpx solid #e5ded1; border-radius:6rpx; background:#fffdf8; }.search-icon { font-size:42rpx; margin-right:16rpx; color:#b18a5c; }.search input { flex:1; min-width:0; font-size:25rpx; }.clear { padding:10rpx; font-size:36rpx; color:#a69b8a; }
.province-scroll { margin-top:28rpx; white-space:nowrap; }.provinces { display:flex; }.province { flex:none; padding:12rpx 22rpx; margin-right:14rpx; font-size:23rpx; border:1rpx solid #ddd4c5; border-radius:30rpx; color:#867e72; }.province.active { background:#255c5c; border-color:#255c5c; color:#fff8ec; }.results-head { display:flex; justify-content:space-between; align-items:center; margin:36rpx 0 24rpx; font-size:30rpx; }.count { font-size:22rpx; color:#ad9a80; }
.card-actions{display:flex;gap:10rpx;margin-top:20rpx}.photo-button{display:flex;flex:1;align-items:center;justify-content:center;gap:8rpx;box-sizing:border-box;height:54rpx;margin-top:0;border:1rpx solid #c89659;border-radius:4rpx;color:#79522b;font-size:21rpx}.photo-button{border-color:#648c88;color:#255c5c}
.photo-mask{position:fixed;z-index:30;inset:0;display:flex;align-items:flex-end;background:rgba(8,28,31,.7);animation:photoMaskIn .25s ease both}.photo-sheet{width:100%;max-height:78vh;box-sizing:border-box;padding:24rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));overflow-y:auto;background:#f7f2e8;border-radius:22rpx 22rpx 0 0;animation:photoSheetIn .55s cubic-bezier(.16,1,.3,1) both}.photo-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24rpx}.photo-kicker{display:block;color:#9d7649;font-size:19rpx;letter-spacing:2rpx}.photo-title{display:block;margin-top:8rpx;color:#173f48;font-size:36rpx;font-weight:600}.photo-close{display:flex;width:54rpx;height:54rpx;align-items:center;justify-content:center;border:1rpx solid #d6ccbc;color:#6f746d;font-size:36rpx}.photo-gallery{display:flex;gap:14rpx}.photo-item{width:calc(50% - 7rpx);min-width:0;background:#e7dfd2}.photo-item:only-child{width:100%}.photo-media{position:relative;height:300rpx;overflow:hidden;background:#d9d1c4}.photo-media image{display:block;width:100%;height:100%;opacity:0;transition:opacity .35s ease}.photo-media image.loaded{opacity:1}.photo-loading,.photo-error{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#81796d;font-size:20rpx}.photo-credit{display:block;padding:12rpx 12rpx 8rpx;color:#71695e;font-size:17rpx;line-height:1.4}.photo-source{display:block;padding:0 12rpx 14rpx;color:#845d32;font-size:17rpx;text-decoration:underline}.photo-status{min-height:280rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#66756f;font-size:23rpx}.photo-spinner{width:50rpx;height:50rpx;margin-bottom:18rpx;border:4rpx solid rgba(37,92,92,.18);border-top-color:#255c5c;border-radius:50%;animation:photoSpin .8s linear infinite}.photo-retry{margin-top:20rpx;padding:13rpx 28rpx;border:1rpx solid #a67a47;color:#80592e}.photo-error{z-index:2;background:#ded7ca}@keyframes photoSpin{to{transform:rotate(360deg)}}@keyframes photoMaskIn{from{opacity:0}to{opacity:1}}@keyframes photoSheetIn{from{opacity:0;transform:translateY(100%)}to{opacity:1;transform:translateY(0)}}
.grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:22rpx; }.card { overflow:hidden; background:#fffdf8; border:1rpx solid #e8e0d3; border-radius:6rpx; }.art { position:relative; height:218rpx; overflow:hidden; background:#c49a62; }.art-1 { background:#a96e54; }.art-2 { background:#4f8580; }.art-3 { background:#74989a; }.card-photo{position:absolute;z-index:0;inset:0;width:100%;height:100%;opacity:0;transform:scale(1.03);transition:opacity .4s ease,transform .8s cubic-bezier(.16,1,.3,1)}.card-photo.loaded{opacity:1;transform:scale(1)}.art-photo-shade{position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,rgba(7,28,30,.08),rgba(7,28,30,.58))}.grade { position:absolute; z-index:2; left:18rpx; top:16rpx; padding:4rpx 10rpx; border:1rpx solid rgba(255,255,255,.6); background:rgba(8,30,31,.18); font-size:20rpx; color:#fff9eb; }.sun { position:absolute; width:90rpx; height:90rpx; right:34rpx; top:30rpx; border-radius:50%; background:rgba(247,213,151,.7); }.mountain { position:absolute; bottom:-30rpx; width:0; height:0; border-left:170rpx solid transparent; border-right:170rpx solid transparent; border-bottom:210rpx solid rgba(28,76,76,.7); }.one { left:-60rpx; }.two { left:70rpx; transform:scale(.8); border-bottom-color:rgba(247,232,193,.48); }.art-province { position:absolute;z-index:2; bottom:18rpx; left:20rpx; color:#fff8ec; font-size:22rpx; letter-spacing:3rpx;text-shadow:0 2rpx 8rpx rgba(0,0,0,.38) }.copy { padding:22rpx 18rpx; }.name { display:block; font-size:27rpx; line-height:1.5; font-weight:600; overflow-wrap:break-word; }.city { display:block; margin-top:12rpx; color:#ad8d68; font-size:20rpx; }more,.end { text-align:center; padding:34rpx 0; color:#255c5c; font-size:24rpx; }.end { color:#a49a8a; }.empty { padding:100rpx 0; text-align:center; color:#827b70; font-size:28rpx; }.empty text { display:block; margin-top:14rpx; color:#aaa093; font-size:22rpx; }.source { text-align:center; color:#a49a8a; font-size:19rpx; line-height:1.7; margin-top:20rpx; }
.recent{margin-top:24rpx}.recent-head{display:flex;justify-content:space-between;color:#173f48;font-size:23rpx}.recent-head text:last-child{color:#9d8d78;font-size:19rpx}.recent-list{display:flex;gap:12rpx;margin-top:14rpx}.recent-item{flex:none;width:190rpx;padding:16rpx;background:#fffdf8;border:1rpx solid #e2d9cc}.recent-item text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.recent-item text:first-child{color:#b17d48;font-size:17rpx}.recent-item text:nth-child(2){margin-top:7rpx;color:#173f48;font-size:22rpx;font-weight:600}.recent-item text:last-child{margin-top:6rpx;color:#9a9082;font-size:17rpx}
