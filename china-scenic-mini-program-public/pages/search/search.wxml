<view class="page motion-page">
  <view class="header"><view class="back" bindtap="goBack">‹</view><view><text class="eyebrow">CHINA · DESTINATIONS</text><text class="title">全国景区</text></view><text class="travel-entry" bindtap="openTravel">旅行中心</text></view>
  <view class="subtitle">5A {{fiveACount}} 处 · 4A {{fourACount}} 处 · 3A {{threeACount}} 处 · 地标 {{landmarkCount}} 处</view>
  <view class="search"><text class="search-icon">⌕</text><input value="{{keyword}}" placeholder="搜索景区、省份或城市" bindinput="onSearch" confirm-type="search"/><text wx:if="{{keyword}}" class="clear" bindtap="clearSearch">×</text></view>
  <view wx:if="{{recentSpots.length && !keyword}}" class="recent"><view class="recent-head"><text>最近浏览</text><text bindtap="clearRecent">清空</text></view><scroll-view scroll-x="true" show-scrollbar="false"><view class="recent-list"><view wx:for="{{recentSpots}}" wx:key="id" class="recent-item" data-index="{{index}}" bindtap="openRecent"><text>{{item.grade === 'landmark' ? '地标' : item.grade}}</text><text>{{item.name}}</text><text>{{item.province}}</text></view></view></scroll-view></view>
  <scroll-view class="province-scroll" scroll-x="true" show-scrollbar="false"><view class="provinces"><view wx:for="{{provinces}}" wx:key="*this" class="province {{activeProvince === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectProvince">{{item}}</view></view></scroll-view>
  <view class="grades"><view wx:for="{{grades}}" wx:key="*this" class="province {{activeGrade === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectGrade">{{item === '全部' ? '全部等级' : item === '地标' ? '地标' : item + ' 景区'}}</view></view>
  <view class="results-head"><text>{{keyword ? '搜索结果' : activeGrade === '地标' ? '全国地标' : '全部目的地'}}</text><text class="count">{{resultCount}} 个目的地</text></view>
  <view wx:if="visibleSpots.length" class="grid"><view wx:for="{{visibleSpots}}" wx:key="id" class="card" data-id="{{item.sourceId}}" data-grade="{{item.sourceGrade}}" bindtap="openDetail"><view class="art art-{{index % 4}}"><image wx:if="{{item.cover && !item.coverError}}" class="card-photo {{item.coverLoaded ? 'loaded' : ''}}" src="{{item.cover}}" mode="aspectFill" data-key="{{item.photoKey}}" bindload="onCardImageLoad" binderror="onCardImageError"/><view wx:if="{{item.cover && !item.coverError}}" class="art-photo-shade"></view><block wx:else><view class="sun"></view><view class="mountain one"></view><view class="mountain two"></view></block><text class="grade">{{item.grade}}</text><text class="art-province">{{item.province}}</text></view><view class="copy"><text class="name">{{item.name}}</text><text class="city">{{item.province}}{{item.city ? ' · ' + item.city : ''}}</text><text class="summary">{{item.summary}}</text><view class="detail-link">查看详情 <text>›</text></view><view class="card-actions"><view wx:if="{{item.grade === '地标'}}" class="photo-button" data-id="{{item.id}}" catchtap="openLandmarkPhotos"><text>▧</text><text>看图片</text></view></view></view></view></view>
  <view wx:if="!resultCount" class="empty">还没有找到这处风景<text>换个关键词或省份试试</text></view>
  <view wx:if="hasMore" class="more" bindtap="loadMore">加载更多景区 ↓</view>
  <view wx:elif="resultCount" class="end">已展示全部 {{resultCount}} 处景区</view>
  <view class="source">第三方名录快照 · 景区评级以文旅部门公告为准</view>
  <view wx:if="{{photoPreview}}" class="photo-mask" bindtap="closeLandmarkPhotos"><view class="photo-sheet" catchtap="stopPhotoTap"><view class="photo-head"><view><text class="photo-kicker">{{photoPreview.province}} · 地标图片</text><text class="photo-title">{{photoPreview.name}}</text></view><text class="photo-close" bindtap="closeLandmarkPhotos">×</text></view><view wx:if="{{photoPreview.loading}}" class="photo-status"><view class="photo-spinner"></view><text>正在查找地标图片</text></view><view wx:elif="{{photoPreview.images.length}}" class="photo-gallery"><view wx:for="{{photoPreview.images}}" wx:key="src" class="photo-item"><view class="photo-media"><view wx:if="{{!item.loaded && !item.error}}" class="photo-loading">图片加载中</view><image wx:if="{{!item.error}}" class="{{item.loaded ? 'loaded' : ''}}" src="{{item.src}}" mode="aspectFill" data-id="{{photoPreview.id}}" data-index="{{index}}" bindload="onLandmarkImageLoad" binderror="onLandmarkImageError"/><view wx:else class="photo-error">图片加载失败</view></view><text class="photo-credit">{{item.credit}}</text><text wx:if="{{item.sourceUrl}}" class="photo-source" data-index="{{index}}" bindtap="showLandmarkSource">查看图片来源与许可 ↗</text></view></view><view wx:else class="photo-status"><text>暂未找到可靠的地标图片</text><view class="photo-retry" bindtap="retryLandmarkPhotos">重新查找</view></view></view></view>
</view>
