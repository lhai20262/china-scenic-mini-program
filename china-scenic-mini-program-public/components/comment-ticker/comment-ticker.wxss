.comment-zone{position:relative;z-index:4;margin-top:0;background:#f4f0e8;color:#173f48;animation:commentZoneIn .5s .16s cubic-bezier(.16,1,.3,1) both}
.ticker{height:82rpx;overflow:hidden;border-top:1rpx solid rgba(255,255,255,.12);border-bottom:1rpx solid #d9d0c3;background:#173f48;color:#fff}
.ticker-track{display:flex;width:max-content;height:82rpx;align-items:center;animation:commentScroll 30s linear infinite;will-change:transform}
.ticker-group{display:flex;flex:none;height:82rpx;align-items:center;gap:18rpx;padding-right:18rpx}
.bubble{display:flex;flex:none;max-width:480rpx;align-items:center;padding:12rpx 20rpx;border:1rpx solid rgba(239,195,130,.35);background:rgba(255,255,255,.08);color:rgba(255,255,255,.9);font-size:21rpx;white-space:nowrap}
.bubble-mark{margin-right:8rpx;color:#efc382;font-size:28rpx}
.ticker-empty{height:82rpx;line-height:82rpx;text-align:center;color:rgba(255,255,255,.58);font-size:20rpx;letter-spacing:1rpx}
.comment-bar{display:flex;align-items:center;padding:20rpx 32rpx;background:#fffdf8;border-bottom:1rpx solid #e2d9cc}
.comment-bar>view:first-child{flex:1}.comment-title,.comment-count{display:block}.comment-title{font-size:24rpx;font-weight:600}.comment-count{margin-top:5rpx;color:#9a9082;font-size:17rpx}.comment-button{padding:12rpx 18rpx;border:1rpx solid #b98b57;color:#805b33;font-size:19rpx}
.editor{display:flex;gap:12rpx;padding:18rpx 32rpx;background:#fffdf8;transform-origin:50% 0;animation:editorOpen .32s cubic-bezier(.16,1,.3,1) both}.editor input{flex:1;height:66rpx;padding:0 18rpx;border:1rpx solid #d8cec0;background:#f4f0e8;font-size:21rpx}.submit{display:flex;width:100rpx;align-items:center;justify-content:center;background:#255c5c;color:#fff;font-size:21rpx}
.manage-list{max-height:240rpx;padding:0 32rpx;box-sizing:border-box;background:#fffdf8}.manage-row{display:flex;align-items:center;padding:16rpx 0;border-top:1rpx solid #e7dfd4;font-size:20rpx}.manage-row text{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.manage-row view{margin-left:16rpx;color:#a16949;font-size:18rpx}
@keyframes commentScroll{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
@keyframes commentZoneIn{from{opacity:0;transform:translateY(22rpx)}to{opacity:1;transform:translateY(0)}}
@keyframes editorOpen{from{opacity:0;transform:scaleY(.7) translateY(-12rpx)}to{opacity:1;transform:scaleY(1) translateY(0)}}
